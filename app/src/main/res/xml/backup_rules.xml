<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for Android 11 and older. The encrypted note database and its attachments
   are excluded because their encryption key lives in the device Keystore and cannot be restored
   onto another device (a restore would only bring back notes that can no longer be decrypted).
-->
<full-backup-content>
    <exclude domain="database" path="vault_notes_db" />
    <exclude domain="database" path="vault_notes_db-wal" />
    <exclude domain="database" path="vault_notes_db-shm" />
    <exclude domain="database" path="vault_notes_db-journal" />
    <exclude domain="file" path="attachments/" />
</full-backup-content>
